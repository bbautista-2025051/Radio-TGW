{
  "name": "radio-tgw-portal",
  "version": "1.0.0",
  "description": "Portal Oficial de Radio Nacional TGW - La Voz de Guatemala (107.3 FM / 107.5 FM)",
  "main": "dist/server.js",
  "scripts": {
    "build:css": "sass styles/main.scss public/css/main.css --style=compressed --no-source-map",
    "build:ts": "tsc",
    "build": "npm run build:css && npm run build:ts",
    "certs": "tsx scripts/generate-certs.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run certs && npm run db:generate && npm run db:push && npm run db:seed && npm run build",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/node-forge": "^1.3.11",
    "prisma": "^6.4.1",
    "sass": "^1.85.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
